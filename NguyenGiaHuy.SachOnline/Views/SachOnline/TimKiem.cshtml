@model List<NguyenGiaHuy.SachOnline.Models.SACH>

@{
    ViewBag.Title = "Kết quả tìm kiếm";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<h2 class="text-primary">🔍 Kết quả tìm kiếm cho: "@ViewBag.TuKhoa"</h2>

@if (Model.Count == 0)
{
    <p class="text-danger">Không tìm thấy sách nào phù hợp.</p>
}
else
{
    <div class="row">
        @foreach (var sach in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card">
                    <img src="~/Images/@sach.anhSP" class="card-img-top" alt="@sach.TenSach">
                    <div class="card-body">
                        <h5 class="card-title">@sach.TenSach</h5>
                        <p class="card-text text-danger">@sach.GiaBan.Value.ToString("N0") VNĐ</p>
                        <a href="@Url.Action("BookDetail", "SachOnline", new { id = sach.SachID })" class="btn btn-primary btn-sm">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
