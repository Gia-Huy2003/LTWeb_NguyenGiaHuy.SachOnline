@model NguyenGiaHuy.SachOnline.Models.SACH

@{
    ViewBag.Title = "Thông tin chi tiết";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

@if (Model == null)
{
    <div class="alert alert-danger text-center">
        Không tìm thấy sách tương ứng.
    </div>
}
else
{
    if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <style>
        .book-detail {
            display: flex;
            gap: 30px;
            align-items: flex-start;
            margin-top: 30px;
        }

        .book-image {
            width: 300px;
            height: auto;
            flex-shrink: 0;
        }

        .book-info {
            flex-grow: 1;
        }

        .book-info h3 {
            font-weight: bold;
        }

        .book-info p {
            font-size: 16px;
        }

        .price-sale {
            color: red;
            font-size: 22px;
            font-weight: bold;
        }

        .price-old {
            text-decoration: line-through;
            color: gray;
            font-size: 16px;
            margin-left: 8px;
        }

        .discount-percent {
            color: red;
            font-weight: bold;
            font-size: 14px;
            margin-left: 8px;
        }

        .book-actions {
            margin-top: 20px;
        }

        .mota-chi-tiet {
            margin-top: 30px;
            background-color: #f9f9f9;
            padding: 20px;
            border-radius: 6px;
        }

        .related-books {
            margin-top: 40px;
        }

        .related-books h4 {
            margin-bottom: 15px;
        }

        .related-books .card {
            margin-right: 15px;
        }
    </style>

    <h2 class="text-center">Chi tiết sản phẩm</h2>

    <div class="book-detail">
        <img src="~/Images/@Model.anhSP" alt="@Model.TenSach" class="book-image" />

        <div class="book-info">
            <h3>@Model.TenSach</h3>

            <p><strong>Giá bán:</strong>
                @if (Model.GiaKhuyenMai != null && Model.GiaKhuyenMai < Model.GiaBan)
                    {
                        var phanTram = (int)Math.Round((1 - Model.GiaKhuyenMai.Value / Model.GiaBan.Value) * 100);
                        <span class="price-sale">@Model.GiaKhuyenMai.Value.ToString("N0") VNĐ</span>
                        <span class="price-old">@Model.GiaBan.Value.ToString("N0") VNĐ</span>
                        <span class="badge badge-danger ml-2">-@phanTram%</span>
                    }
                    else
                    {
                        <span class="price-normal">@Model.GiaBan.Value.ToString("N0") VNĐ</span>
                    }
            </p>

            <p><strong>Ngày cập nhật:</strong> @Html.FormatValue(Model.NgayCapNhat, "{0:dd/MM/yyyy}")</p>
            <p><strong>Mô tả ngắn:</strong> @Model.MoTaNgan</p>

            <div class="book-actions">
                <a href="@Url.Action("ThemGioHang", "GioHang", new { ms = Model.SachID, url = Request.Url.ToString() })" class="btn btn-primary">
                    <span class="glyphicon glyphicon-shopping-cart"></span> Thêm vào giỏ hàng
                </a>
            </div>
        </div>
    </div>

    <div class="mota-chi-tiet">
        <h4>Mô tả chi tiết</h4>
        <p>
            @Html.Raw((Model.Mota ?? "Chưa có mô tả.").Replace("\n", "</p><p>&nbsp;&nbsp;&nbsp;&nbsp;"))
        </p>
    </div>

    <div class="related-books">
        <h4>Sách cùng chủ đề</h4>
        <div class="d-flex flex-row">
            @{
                var relatedBooks = new NguyenGiaHuy.SachOnline.Models.SachOnline1Entities1().SACHes
                    .OrderByDescending(s => s.NgayCapNhat)
                    .Take(3)
                    .ToList();

                foreach (var item in relatedBooks)
                {
                    <div class="card" style="width: 12rem;">
                        <img src="~/Images/@item.anhSP" class="card-img-top" alt="@item.TenSach">
                        <div class="card-body">
                            <h6 class="card-title">@item.TenSach</h6>
                            <a href="@Url.Action("BookDetail", "SachOnline", new { id = item.SachID })" class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}
