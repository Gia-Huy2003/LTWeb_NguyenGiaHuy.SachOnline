@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<style type="text/css">
    h4 {
        color: red;
        text-align: center;
    }

    h2 {
        text-align: center;
    }

    table {
        margin: 0 auto;
        border-collapse: collapse;
        width: 50%;
    }

    td {
        padding: 10px;
        text-align: right;
    }

    input[type="text"],
    input[type="password"] {
        width: 100%;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    input[type="submit"],
    input[type="reset"] {
        padding: 8px 16px;
        background-color: #007BFF;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        width: 154px;
    }

    input[type="submit"]:hover,
    input[type="reset"]:hover {
        background-color: #0056b3;
    }

    .error-message {
        color: red;
    }

    .show-password {
        text-align: left;
        padding-top: 0;
        font-size: 14px;
        padding-left: 10px;
    }
</style>

<h4>@ViewBag.ThongBao</h4>
<table align="center">
    <h2>ĐĂNG KÝ THÀNH VIÊN</h2>
    @using (Html.BeginForm("DangKy", "SachOnline"))
    {
        <tr>
            <td>Họ tên:</td>
            <td>@Html.TextBox("TenKhachHang") <span class="error-message">@ViewData["err1"]</span></td>
        </tr>
        <tr>
            <td>Tên đăng nhập:</td>
            <td>@Html.TextBox("TenDN") <span class="error-message">@ViewData["err2"]</span></td>
        </tr>
        <tr>
            <td>Mật khẩu:</td>
            <td>
                @Html.Password("MatKhau", null, new { id = "MatKhau" })
                <span class="error-message">@ViewData["err3"]</span>
            </td>
        </tr>
        <tr>
            <td>Nhập lại mật khẩu:</td>
            <td>
                @Html.Password("MatKhauNL", null, new { id = "MatKhauNL" })
                <span class="error-message">@ViewData["err4"]</span>
            </td>
        </tr>
        <tr>
            <td></td>
            <td class="show-password">
                <input type="checkbox" id="showPasswords" onclick="toggleAllPasswords()" />
                <label for="showPasswords">Hiển thị mật khẩu</label>
            </td>
        </tr>
        <tr>
            <td>Email:</td>
            <td>@Html.TextBox("Email") <span class="error-message">@ViewData["err5"]</span></td>
        </tr>
        <tr>
            <td>Điện thoại:</td>
            <td>@Html.TextBox("SoDienThoai") <span class="error-message">@ViewData["err6"]</span></td>
        </tr>
        <tr>
            <td>Địa chỉ:</td>
            <td><input type="text" name="DiaChi" /></td>
        </tr>
        <tr>
            <td></td>
            <td>
                <input type="submit" value="Đăng ký" />
                <input type="reset" value="Xóa Thông Tin" />
            </td>
        </tr>
    }
</table>

<script type="text/javascript">
    function toggleAllPasswords() {
        const pw1 = document.getElementById("MatKhau");
        const pw2 = document.getElementById("MatKhauNL");
        const type = pw1.type === "password" ? "text" : "password";
        pw1.type = type;
        pw2.type = type;
    }

    $(document).ready(function () {
        var successMessage = '@TempData["SuccessMessage"]';
        if (successMessage) {
            alert(successMessage);
        }
    });
</script>
