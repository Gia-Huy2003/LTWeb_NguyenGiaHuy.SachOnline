@model NguyenGiaHuy.SachOnline.Models.DoiMatKhauViewModel
@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<h2>Đổi mật khẩu</h2>

@using (Html.BeginForm("DoiMatKhau", "Home", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="form-group">
        @Html.LabelFor(m => m.TenDN)
        @Html.TextBoxFor(m => m.TenDN, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.MatKhauCu)
        @Html.PasswordFor(m => m.MatKhauCu, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.MatKhauMoi)
        @Html.PasswordFor(m => m.MatKhauMoi, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.XacNhanMatKhauMoi)
        @Html.PasswordFor(m => m.XacNhanMatKhauMoi, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
}

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-success text-center">
        @ViewBag.ThongBao
    </div>
}
