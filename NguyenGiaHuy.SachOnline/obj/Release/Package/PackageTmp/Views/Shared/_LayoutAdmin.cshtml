@using NguyenGiaHuy.SachOnline.Models
@{
    var admin = Session["TaiKhoanAdmin"] as ADMIN;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Trang Quản Trị</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
        }

        .nav {
            background-color: #343a40;
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .nav-left a,
        .nav-right a {
            color: white;
            margin-right: 20px;
            text-decoration: none;
            font-weight: 500;
        }

        .nav-left a:hover,
        .nav-right a:hover {
            text-decoration: underline;
            color: #00ffd5;
        }

        .admin-greeting {
            color: #00ffcc;
            font-weight: bold;
            margin-right: 15px;
        }

        .admin-header {
            background: linear-gradient(45deg, #343a40, #495057);
            color: white;
            padding: 25px 30px;
            border-bottom: 4px solid #00ffc8;
            text-align: center;
        }

        .admin-header h1 {
            margin: 0;
            font-size: 28px;
        }

        .admin-header small {
            font-size: 16px;
            color: #ccc;
        }

        .dashboard-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .dashboard-card {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            padding: 25px;
            text-align: center;
            transition: transform 0.2s;
        }

        .dashboard-card:hover {
            transform: translateY(-4px);
        }

        .dashboard-card i {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .dashboard-card a {
            display: block;
            font-size: 16px;
            font-weight: bold;
            color: #333;
            text-decoration: none;
        }

        .dashboard-card a:hover {
            color: #007bff;
        }

        footer {
            text-align: center;
            padding: 15px;
            color: #888;
            background-color: #e9ecef;
            border-top: 1px solid #dee2e6;
            margin-top: 40px;
        }

        .content {
            padding: 30px;
        }
    </style>
</head>
<body>
    <!-- Thanh điều hướng -->
    <div class="nav">
        <div class="nav-left">
            <b style="color:white; margin-right:20px">📘 Trang quản trị</b>
        </div>
        <div class="nav-right">
            @if (admin != null)
            {
                <span class="admin-greeting">🛡️ Xin chào, @admin.Username</span>
            }
            <a href="@Url.Action("Logout", "Home", new { area = "Admin" })">Đăng xuất</a>
        </div>
    </div>

    <!-- Tiêu đề trang -->
    <div class="admin-header">
        <h1>@ViewBag.Title</h1>
        <small>Hệ thống quản trị nội dung sách trực tuyến</small>
    </div>

    <!-- Dashboard menu -->
    <div class="container dashboard-cards">
        <div class="dashboard-card">
            <i class="fas fa-book text-primary"></i>
            <a href="@Url.Action("Index", "Sach", new { area = "Admin" })">Quản lý sách</a>
        </div>
        <div class="dashboard-card">
            <i class="fas fa-layer-group text-secondary"></i>
            <a href="@Url.Action("QuanLyChuDe", "ChuDe", new { area = "Admin" })">Quản lý chủ đề</a>
        </div>
        <div class="dashboard-card">
            <i class="fas fa-building text-success"></i>
            <a href="@Url.Action("Index", "NhaXuatBan", new { area = "Admin" })">Nhà xuất bản</a>
        </div>
        <div class="dashboard-card">
            <i class="fas fa-users text-info"></i>
            <a href="@Url.Action("QuanLyKhachHang", "KhachHang", new { area = "Admin" })">Khách hàng</a>
        </div>
        <div class="dashboard-card">
            <i class="fas fa-file-invoice-dollar text-warning"></i>
            <a href="@Url.Action("QuanLyDonHang", "Admin", new { area = "Admin" })">Đơn hàng</a>
        </div>
        <div class="dashboard-card">
            <i class="fas fa-chart-line text-danger"></i>
            <a href="@Url.Action("DoanhThu", "ThongKe", new { area = "Admin" })">Doanh thu</a>
        </div>
    </div>

    <!-- Nội dung cụ thể -->
    <div class="container content">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer>
        &copy; @DateTime.Now.Year - Hệ thống quản trị sách trực tuyến
    </footer>

    <script src="https://cdn.ckeditor.com/4.22.1/ckeditor.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
