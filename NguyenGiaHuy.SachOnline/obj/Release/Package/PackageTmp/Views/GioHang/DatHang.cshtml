@using NguyenGiaHuy.SachOnline.Models

@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
    KHACHHANG kh = (KHACHHANG)Session["TaiKhoan"];
}

<h2 style="text-align:center; font-weight:bold;">ĐƠN HÀNG CỦA BẠN</h2>

@using (Html.BeginForm("DatHang", "GioHang", FormMethod.Post))
{
    <table align="center" border="1">
        <tr style="text-align:center; font-weight:bold;">
            <td>Mã Sách</td>
            <td>Tên Sách</td>
            <td>Ảnh Bìa</td>
            <td>Số Lượng</td>
            <td>Đơn Giá</td>
            <td>Thành Tiền</td>
        </tr>

        @foreach (var item in Model)
        {
            <tr style="text-align:center; font-weight:bold;">
                <td>@item.iSachID</td>
                <td>@item.sTenSach</td>
                <td><img src="~/Images/@item.sAnhSP" style="width:100px;" /></td>
                <td>@item.iSoLuong</td>
                <td>@string.Format("{0:#,##0,0}", item.dGiaTien)</td>
                <td>@string.Format("{0:#,##0,0}", item.dTongTien)</td>
            </tr>
        }

        <tr>
            <td colspan="3" style="text-align:right; color:red; font-weight:bold; padding-right:5px;">
                Số lượng sách: @string.Format("{0:#,##0}", ViewBag.TongSoLuong)
            </td>
            <td colspan="3" style="text-align:center; color:red; font-weight:bold;">
                Tổng tiền: @string.Format("{0:#,##0,0}", ViewBag.TongTien) VNĐ
            </td>
        </tr>

        <tr style="font-weight:bold; color: blue; text-align:right;">
            <td colspan="6">
                @Html.ActionLink("TRỞ VỀ GIỎ HÀNG", "GioHang", "GioHang")
            </td>
        </tr>

        <tr style="height:40px;">
            <td>Phương thức thanh toán:</td>
            <td colspan="5">
                <input type="radio" name="PhuongThucThanhToan" value="COD" checked /> Thanh toán khi nhận hàng
                <input type="radio" name="PhuongThucThanhToan" value="VNPay" style="margin-left:20px;" /> Chuyển khoản
            </td>
        </tr>
    </table>

    <h2 style="text-align:center;">THÔNG TIN ĐẶT HÀNG</h2>
    <table align="center">
        @Html.ValidationSummary(true)

        <tr style="height:40px;">
            <td>Họ tên khách hàng:</td>
            <td style="font-weight:bold">@kh.TenKhachHang</td>
        </tr>
        <tr style="height:40px;">
            <td>Địa chỉ:</td>
            <td>
                @Html.TextBox("DiaChi", null, new {
                    @class = "form-control",
                    required = "required",
                    placeholder = "Nhập địa chỉ nhận hàng"
                })
            </td>
        </tr>
        <tr style="height:40px;">
            <td>Điện thoại:</td>
            <td style="font-weight:bold">@kh.SoDienThoai</td>
        </tr>
        <tr style="height:40px;">
            <td>Ngày đặt:</td>
            <td style="font-weight:bold">@DateTime.Now.ToShortDateString()</td>
        </tr>
        <tr style="height:40px;">
            <td></td>
            <td>
                <input type="submit" value="ĐẶT HÀNG" class="btn btn-primary" />
            </td>
        </tr>
    </table>
}
