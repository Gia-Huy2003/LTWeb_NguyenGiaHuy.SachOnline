@model NguyenGiaHuy.SachOnline.Models.SACH
@{
    ViewBag.Title = "Chỉnh sửa sách";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="text-primary mb-4">Chỉnh sửa sách</h2>

@using (Html.BeginForm("Edit", "Sach", FormMethod.Post, new { area = "Admin", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.SachID)

    <div class="form-group">
        @Html.LabelFor(m => m.TenSach, "Tên sách")
        @Html.TextBoxFor(m => m.TenSach, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Mota, "Mô tả")
        @Html.TextAreaFor(m => m.Mota, new { @class = "form-control", rows = 5, id = "Mota" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.SoLuong, "Số lượng")
        @Html.TextBoxFor(m => m.SoLuong, new { @class = "form-control", type = "number" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.GiaBan, "Giá bán")
        @Html.TextBoxFor(m => m.GiaBan, new { @class = "form-control", type = "number", step = "0.01" })
    </div>

    <div class="form-group">
    <label>Giá khuyến mãi:</label>
    @Html.TextBoxFor(model => model.GiaKhuyenMai, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.MoTaNgan, "Mô tả ngắn")
        @Html.TextAreaFor(m => m.MoTaNgan, new { @class = "form-control", rows = 3, id = "MoTaNgan" })
    </div>

    <div class="form-group">
        <label>Ảnh sản phẩm hiện tại</label><br />
        <img src="@Url.Content("~/Images/" + Model.anhSP)" width="100" class="img-thumbnail mb-2" />
    </div>

    <div class="form-group">
        <label>Chọn ảnh mới (nếu muốn thay)</label>
        <input type="file" name="uploadFile" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">💾 Lưu thay đổi</button>
    <a href="@Url.Action("Index", "Sach", new { area = "Admin" })" class="btn btn-secondary">❌ Hủy</a>
}

@section Scripts {
    <!-- CKEditor CDN -->
    <script src="https://cdn.ckeditor.com/4.22.1/ckeditor.js"></script>
    <script>
        // Áp CKEditor lên tất cả các Textarea trong trang
        document.querySelectorAll('textarea').forEach(function(textarea) {
            CKEDITOR.replace(textarea.id);
        });
    </script>
}
