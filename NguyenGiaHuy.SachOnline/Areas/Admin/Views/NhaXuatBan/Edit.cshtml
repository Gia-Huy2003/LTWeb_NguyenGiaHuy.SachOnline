@model NguyenGiaHuy.SachOnline.Models.NHAXUATBAN
@{
    ViewBag.Title = "Sửa Nhà xuất bản";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="text-warning mb-4 text-center">📝 Sửa Nhà xuất bản</h2>

@using (Html.BeginForm("Edit", "NhaXuatBan", FormMethod.Post, new { area = "Admin" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.NhaXuatBanID)

    <div class="form-group">
        @Html.LabelFor(m => m.TenNhaXuatBan, "Tên Nhà xuất bản")
        @Html.TextBoxFor(m => m.TenNhaXuatBan, new { @class = "form-control", required = "required" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.DiaChi, "Địa chỉ")
        @Html.TextAreaFor(m => m.DiaChi, new { @class = "form-control", rows = 3, id = "DiaChi" })
    </div>

    <button type="submit" class="btn btn-primary">💾 Cập nhật</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">🔙 Quay lại</a>
}

@section Scripts {
    <script src="https://cdn.ckeditor.com/4.22.1/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('DiaChi');
    </script>
}
